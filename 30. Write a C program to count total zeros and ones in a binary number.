/******************************************************************************
30. Write a C program to count total zeros and ones in a binary number.
*******************************************************************************/
#include <stdio.h>

void countZerosOnes(unsigned int num, int *zeros, int *ones) {
    *zeros = 0;
    *ones = 0;

    unsigned int mask = 1 << 31;

    for (int i = 0; i < 32; i++) {
        if (num & mask)
            (*ones)++;
        else
            (*zeros)++;
        mask >>= 1;
    }
}

int main() {
    unsigned int num;
    int zeros, ones;

    printf("Enter a number: ");
    scanf("%u", &num);

    countZerosOnes(num, &zeros, &ones);

    printf("Binary representation has:\n");
    printf("Zeros = %d\n", zeros);
    printf("Ones  = %d\n", ones);

    return 0;
}
