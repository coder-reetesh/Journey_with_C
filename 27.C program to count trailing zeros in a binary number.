/******************************************************************************
27. Write a C program to count trailing zeros in a binary number.
*******************************************************************************/
#include <stdio.h>

int main()
{
    int num,count=0;
    printf("Enter the num = ");
    scanf("%d",&num);
    if(num==0)
    {
        printf("All bits are 0. Trailling 0 are 32 bit");
    }
    
    while((num & 1)==0)
    {
        count++;
        num>>=1;
    }
    printf("count trailing zeros :%d",count);
    return 0;
}
